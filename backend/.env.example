# Copie ce fichier en « .env » (même dossier) et remplis ta clé. Le fichier .env n'est pas versionné.

ANTHROPIC_API_KEY=

# Modèle de l'agent, au format fournisseur:modèle. Exemples :
#   anthropic:claude-haiku-4-5-20251001   (défaut)
#   openai:gpt-4o-mini                    (pip install langchain-openai,       OPENAI_API_KEY)
#   google_genai:gemini-2.5-flash         (pip install langchain-google-genai, GOOGLE_API_KEY)
#   ollama:qwen3:8b                       (pip install langchain-ollama, modèle local, aucune clé)
# VA_LLM=anthropic:claude-haiku-4-5-20251001

# VA_AGENT=auto        # auto : agent si un modèle est configuré, sinon regex ; off : regex seulement
# VA_LANG=fr           # fr, en, ar
# VA_CITY=Sousse       # ville par défaut pour la météo
# VA_MODEL=small       # modèle Whisper : tiny, base, small, medium
