# Copie ce fichier sous le nom .env (jamais envoyé sur GitHub) et remplis ta clé.

# Modèle de l'agent, au format « fournisseur:modèle » de LangChain
VA_LLM=google_genai:gemini-3.5-flash-lite
GOOGLE_API_KEY=ta-clé-ici
# VA_LLM=anthropic:claude-haiku-4-5-20251001   (avec ANTHROPIC_API_KEY)
# VA_LLM=ollama:qwen3:8b                         (modèle local, aucune clé)

# Reconnaissance vocale
VA_MODEL=small                 # tiny, base, small, medium
VA_LANG=fr
VA_CITY=Sousse                 # ville par défaut pour la météo
# VA_WORD_CONFIDENCE=0         # désactive le soulignement des mots incertains (transcription un peu plus rapide)
